# Sunucu
PORT=4000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=petlas_saha_kb
DB_USER=petlas_admin
DB_PASSWORD=change_me_strong_password

# JWT
JWT_SECRET=change_me_super_secret_key_min_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_me_another_super_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# İlk admin kullanıcı (yalnızca seed script'i için)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@petlas.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!

# Şifremi Unuttum e-postası için SMTP (opsiyonel - boş bırakılırsa link konsola yazılır, mail gitmez)
# Gmail kullanacaksan: normal şifren değil, "Uygulama Şifresi" (App Password) üretmen gerekir:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Petlas Saha KB <noreply@petlas.com>

# Şifre sıfırlama linkinin yönlendireceği frontend adresi
APP_URL=http://localhost:8080
